DATABASE_URL=postgresql://laya_gateway:replace-me@127.0.0.1:5432/laya_gateway
GATEWAY_LEDGER_MODE=postgres
LAYA_PRIMARY_API_KEY=replace-with-worker-key
LAYA_SECONDARY_API_KEY=replace-with-worker-key
LAYA_GATEWAY_CONFIG=config/workers.toml
GATEWAY_QUEUE_CAPACITY=64
GATEWAY_QUEUE_TIMEOUT_SECONDS=30
GATEWAY_PROBE_INTERVAL_SECONDS=2
GATEWAY_STALE_AFTER_SECONDS=6
